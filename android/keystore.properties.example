# RNF-21 — copiar para android/keystore.properties (já no .gitignore) e
# preencher com o keystore de release real. NUNCA commitar o arquivo
# resultante nem o .keystore em si.
#
# Gerar o keystore (executar uma vez, guardar o arquivo e as senhas em local
# seguro — perder isso impede publicar futuras atualizações na mesma ficha
# da loja):
#   keytool -genkeypair -v -keystore fynvex-release.keystore -alias fynvex \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile é relativo à pasta android/ (mesma convenção do keystore de debug).
storeFile=fynvex-release.keystore
storePassword=
keyAlias=fynvex
keyPassword=
