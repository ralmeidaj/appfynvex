# Copiar para .env e ajustar conforme o ambiente
# Emulador Android:       API_URL=http://10.0.2.2:8091/api/v1/app
# Dispositivo físico:     API_URL=http://192.168.x.x:8091/api/v1/app
# Produção:               API_URL=https://api.fynvex.com.br/api/v1/app
API_URL=http://10.0.2.2:8091/api/v1/app

# Enquanto os endpoints novos (/api/v1/app/*) não existem no backend e o
# fornecedor de leitura facial não foi escolhido (RF-BIO-08), o app roda
# inteiramente contra a camada de mock em src/api/mocks/.
USE_MOCK_API=true
